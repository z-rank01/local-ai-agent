{
  "id": "finance",
  "version": "1.0.0",
  "harness_api": 1,
  "adapter": "plugins.finance.service:stock_service",
  "call_policy": "plugins.finance.call_policy:FinanceCallPolicy",
  "turn_policy": "plugins.finance.turn:FinanceTurn",
  "reply_purposes": {
    "stock_report_read": ["analysis", "calculation"],
    "stock_public_evidence_read": ["analysis", "source_scope"]
  },
  "review_prompt": "prompts/review.txt",
  "research_session": "plugins.finance.research.session:ResearchSession",
  "agent_roles": [
    {
      "role_id": "finance_evidence",
      "prompt_path": "prompts/evidence.md",
      "tools": ["web_search", "web_fetch", "stock_public_evidence_find", "stock_public_evidence_read", "stock_report_read", "skill_list", "skill_info", "file_read", "code_exec"],
      "output": {"artifact_kind": "source_excerpts", "recipe_namespace": "evidence", "schema": {"type": "object", "required": ["excerpts"], "properties": {"excerpts": {"type": "array", "items": {"type": "object", "required": ["id", "source_id", "quote"]}}}}}
    },
    {
      "role_id": "finance_calculation",
      "prompt_path": "prompts/calculation.md",
      "tools": ["code_exec"],
      "depends_on": ["finance_evidence"],
      "output": {
        "artifact_kind": "calculation",
        "recipe_namespace": "calculations",
        "schema": {
          "type": "object",
          "required": [
            "calculations",
            "figures"
          ],
          "properties": {
            "calculations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "operation",
                  "inputs",
                  "unit",
                  "evidence_refs"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "sum",
                      "subtract",
                      "multiply",
                      "divide"
                    ],
                    "description": "单项仅一个运算；subtract、multiply、divide恰好两个输入。多项算式拆成依赖前项的多条计算。"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string",
                    "description": "省略，由程序计算；不得填写近似值。"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "取证摘录别名或实际artifact引用；这里与inputs.source不是同一种引用。"
                  },
                  "inputs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "source",
                        "period"
                      ],
                      "properties": {
                        "source": {
                          "type": "string",
                          "description": "精确的金融source_id（例如S0123）；不能填摘录别名、task_evidence编号或附加说明。前项结果用calculation:零起始索引；常数用constant:含义且period=不适用。"
                        },
                        "value": {
                          "type": "string",
                          "description": "原文或常数原值；前项计算引用可省略。"
                        },
                        "unit": {
                          "type": "string",
                          "description": "原值实际单位；前项计算可省略并继承。"
                        },
                        "period": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "figures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "unit",
                  "period",
                  "items"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "period": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "label"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string",
                          "description": "精确金融source_id；原值须在摘录内。"
                        },
                        "value": {
                          "type": "string"
                        },
                        "calculation": {
                          "type": "integer",
                          "description": "本成果calculations的零起始索引，引用时省略value。"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "role_id": "finance_analysis",
      "prompt_path": "prompts/analysis.md",
      "depends_on": ["finance_evidence", "finance_calculation"],
      "output": {"artifact_kind": "claims", "recipe_namespace": "analysis", "schema": {"type": "object", "required": ["claims"], "properties": {"claims": {"type": "array"}}}}
    },
    {
      "role_id": "finance_review",
      "prompt_path": "prompts/review.md",
      "depends_on": ["finance_analysis"],
      "output": {"artifact_kind": "claim_checks", "recipe_namespace": "review", "schema": {"type": "object", "required": ["claim_checks", "read_requests"], "properties": {"claim_checks": {"type": "array"}, "read_requests": {"type": "array"}}}}
    }
  ],
  "research_methods": [
    "harness-stock-research-v1",
    "harness-stock-research-v2",
    "harness-stock-research-v3",
    "harness-stock-research-v4",
    "market-research-methods-v1"
  ],
  "title": "金融研究",
  "description": "研究任务、公开证据与报告；账户操作遵循原业务确认规则",
  "backends": [
    "stock-bridge",
    "research-runtime"
  ],
  "tool_directory": "tools",
  "task_provider": "plugins.finance.tasks:FinanceTasks",
  "required": [],
  "optional": [
    "websearch"
  ],
  "permissions": [
    "finance_service"
  ],
  "ui": {
    "settings": "apps/web/src/plugins/finance/index.tsx",
    "title": "股票后台",
    "group": "股票",
    "description": "后台任务执行与每日简报",
    "order": 20
  },
  "prompts": [
    {
      "path": "prompts/methods.txt",
      "when_tools": [
        "research_begin",
        "stock_report_read",
        "stock_research_submit"
      ]
    },
    {
      "path": "prompts/tools.txt",
      "when_tools": [
        "research_begin",
        "stock_report_read",
        "stock_research_submit"
      ]
    },
    {
      "path": "prompts/research.txt",
      "when_tools": [
        "research_begin",
        "stock_report_read",
        "stock_research_submit"
      ]
    }
  ],
  "artifacts": {
    "provider": "plugins.finance.artifacts:FinanceArtifacts",
    "owner": "stock-bridge",
    "type": "finance-report",
    "renderer": "apps/web/src/plugins/finance/artifact.tsx",
    "tools": [
      "stock_report_read",
      "brief_publish"
    ]
  },
  "tool_roles": {
    "history_projection": ["brief_publish"],
    "research_blocked": [
      "stock_research_resume", "stock_research_cancel",
      "stock_candidate_screen",
      "stock_market_brief_continue", "stock_track_follow", "stock_track_ignore"
    ],
    "source_read": [
      "stock_report_read",
      "stock_public_evidence_read"
    ],
    "research": [
      "stock_public_evidence_read",
      "stock_public_evidence_find",
      "stock_report_read",
      "stock_research_find",
      "stock_research_submit",
      "stock_theme_research_find",
      "stock_theme_research_submit",
      "stock_market_brief",
      "stock_track_read",
      "stock_track_find"
    ]
  }
}
