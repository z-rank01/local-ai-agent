# Secrets & local env — do not commit
.env
.webui_secret_key

# Python artefacts
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Data — runtime user data, managed separately (workspace has its own git)
data/

# Node / Web frontend artefacts
apps/web/node_modules/
apps/web/dist/
apps/web/*.tsbuildinfo

# SearXNG runtime generated files
config/searxng/uwsgi.ini

# Private notes
后续需求.md

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build-generated plugin UI registry
apps/web/src/extensions/generated.ts

# Locally installed plugin payloads are user-managed, never repository commits.
/plugins/*/
!/plugins/finance/
!/plugins/websearch/
!/plugins/document-index/
!/plugins/document-batch/

# Local acceptance evidence stays untracked except the four holdout inputs referenced by scripts/harness_holdout.py
/verify/*
!/verify/lawsuit_20260715.pdf
!/verify/farm-demand-top.png
!/verify/auto-v1-top.png
!/verify/farm-model-top.png

# Agent session workspace
/.zcode/
