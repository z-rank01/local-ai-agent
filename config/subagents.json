      "tools": [],
      "depends_on": [],
      "output": {
        "artifact_kind": "analysis",
        "recipe_namespace": "analysis",
        "schema": {"type": "object"}
      }
    },
    {
      "role_id": "file_reader",
      "prompt": "你是只读文件子Agent。只能调用file_read读取任务指定的已授权文件，不能调用其他工具、创建其他Agent或发布文件。实际读取后按系统登记契约填写真实路径、正文与回执指纹，不猜测未读内容，不返回隐藏思维链。",
      "tools": ["file_read"],
      "depends_on": [],
