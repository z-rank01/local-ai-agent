          "type": "object",
          "required": ["path", "text", "sha256"],
          "properties": {
            "path": {"type": "string", "description": "实际读取的路径"},
            "text": {"type": "string", "description": "实际读取的文件正文"},
            "sha256": {"type": "string", "description": "file_read回执指纹"}
          }
        }
      }
    }
  ]
