# ── Ports ──────────────────────────────────────────────────────────────────
# Skill services expose these ports to localhost for TUI/core to call.
SKILL_FILES_PORT=9101
SKILL_RUNNER_PORT=9102
SKILL_WEBSEARCH_PORT=9103

# ── Ollama ─────────────────────────────────────────────────────────────────
# TUI connects directly to Ollama on localhost.
# Docker skill containers use host.docker.internal to reach the host.
OLLAMA_BASE_URL=http://localhost:11434

# Model name — must match exactly what `ollama list` shows.
# Recommended: qwen3.5:27b (strong tool-calling, 24GB+ VRAM)
# Alternatives: qwen2.5:7b, qwen2.5-coder:7b (8GB VRAM)
OLLAMA_MODEL=qwen3.5:27b

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend adapter (Python BFF) ──────────────────────────────────────────
BFF_HOST=127.0.0.1
BFF_PORT=9510

# ── Execution timeouts (seconds) ──────────────────────────────────────────
PYTHON_EXEC_TIMEOUT=120
SHELL_EXEC_TIMEOUT=60

# ── Feature flags ──────────────────────────────────────────────────────────
AUTO_GIT_COMMIT=true

# Web search: requires SearXNG + skill-websearch (start with --profile websearch)
ENABLE_WEBSEARCH=false

# Model catalog and cloud boundary (IN1 launcher uses its own isolated workspace)
# DEFAULT_MODEL=qwen:qwen3.5-flash
# MODEL_CATALOG=config/models.json
# DASHSCOPE_API_KEY=  # Prefer entering through the local Web settings.
WORKSPACE_CLOUD_ALLOWED=false
TOOL_TIER=all
# MODEL_CALL_LIMIT=30  # Persistent HTTP attempt budget, including failed attempts.
