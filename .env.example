# ── Ports ──────────────────────────────────────────────────────────────────
# Skill services expose these ports to localhost for the core runtime.
SKILL_FILES_PORT=9101
SKILL_RUNNER_PORT=9102
SKILL_WEBSEARCH_PORT=9103

# ── Ollama ─────────────────────────────────────────────────────────────────
# Only needed for local models; cloud providers work without it.
# Docker skill containers use host.docker.internal to reach the host.
OLLAMA_BASE_URL=http://localhost:11434

# Model name — must match exactly what `ollama list` shows.
# Recommended: qwen3.5:27b (strong tool-calling, 24GB+ VRAM)
# Alternatives: qwen2.5:7b, qwen2.5-coder:7b (8GB VRAM)
OLLAMA_MODEL=qwen3.5:27b

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend adapter (Python BFF; serves the Web UI on the same port) ──────
BFF_HOST=127.0.0.1
BFF_PORT=9510

# ── Execution timeouts (seconds) ──────────────────────────────────────────
PYTHON_EXEC_TIMEOUT=120
SHELL_EXEC_TIMEOUT=60

# ── Feature flags ──────────────────────────────────────────────────────────
AUTO_GIT_COMMIT=true

# Web search initial default. After the first toggle from the Web page the
# saved switch (data/private/skill-switches.json) wins; ENABLE_WEBSEARCH only
# seeds a fresh install.
ENABLE_WEBSEARCH=false
# Per-turn web search/fetch budgets (each user message gets a fresh allowance)
# WEB_SEARCH_BUDGET=2
# WEB_FETCH_BUDGET=2

# Close-page auto exit: once the page has been opened, stopping heartbeats
# for this long shuts the whole stack down (stock finishes current work first).
AUTO_EXIT_ON_CLOSE=true
# HEARTBEAT_TIMEOUT_SECONDS=15

# Cloud boundary (can also be authorized per-workspace from the model settings)
WORKSPACE_CLOUD_ALLOWED=false
TOOL_TIER=all
# DEFAULT_MODEL=qwen:qwen3.5-flash
# MODEL_CATALOG=config/models.json
# DASHSCOPE_API_KEY=  # Prefer entering through the local Web settings.
# MODEL_CALL_LIMIT=30  # Persistent HTTP attempt budget, including failed attempts.

# Stock bridge advanced override. Daily use is managed from the Web page
# (stock skill panel → 高级管理 → 连接配置); leave empty unless bypassing it.
# STOCK_BRIDGE_URL=http://127.0.0.1:8765
# STOCK_BRIDGE_TOKEN=
