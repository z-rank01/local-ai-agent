# ── Ports ──────────────────────────────────────────────────────────────────
# Skill services expose these ports to localhost for the core runtime.
SKILL_FILES_PORT=9101
SKILL_RUNNER_PORT=9102
SKILL_WEBSEARCH_PORT=9103

# ── Ollama ─────────────────────────────────────────────────────────────────
# Only needed for local models; cloud providers work without it.
# Docker skill containers use host.docker.internal to reach the host.
OLLAMA_BASE_URL=http://localhost:11434

# Model name — must match exactly what `ollama list` shows.
# Recommended: qwen3.5:27b (strong tool-calling, 24GB+ VRAM)
# Alternatives: qwen2.5:7b, qwen2.5-coder:7b (8GB VRAM)
OLLAMA_MODEL=qwen3.5:27b

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend adapter (Python BFF; serves the Web UI on the same port) ──────
BFF_HOST=127.0.0.1
BFF_PORT=9510

# ── Execution timeouts (seconds) ──────────────────────────────────────────
PYTHON_EXEC_TIMEOUT=120
SHELL_EXEC_TIMEOUT=60

# ── Feature flags ──────────────────────────────────────────────────────────
AUTO_GIT_COMMIT=true

# Web search initial default. After the first toggle from the Web page the
# saved switch (data/private/skill-switches.json) wins; ENABLE_WEBSEARCH only
# seeds a fresh install.
ENABLE_WEBSEARCH=false
# Per-turn web search/fetch budgets (each user message gets a fresh allowance).
# 0 = unlimited, which is the default now.
# WEB_SEARCH_BUDGET=0
# WEB_FETCH_BUDGET=0

# Close-page auto exit: once the page has been opened, stopping heartbeats
# for this long shuts the whole stack down (stock finishes current work first).
AUTO_EXIT_ON_CLOSE=true
# HEARTBEAT_TIMEOUT_SECONDS=15

# ── Output limits (0 = unlimited) ─────────────────────────────────────────
# Tool result text handed back to the model. 0 returns the whole result; when a
# cap is set the full payload is spilled to data/private/tool-results and the
# message names the file.
# TOOL_RESULT_MAX_CHARS=0
# Provider max_tokens. 0 leaves the provider default in place.
# MODEL_MAX_OUTPUT_TOKENS=0
# Tool-call rounds per user message. 0 = no cap (research already continues
# while evidence is pending).
# AGENT_MAX_ROUNDS=0
# Seconds one stock/research tool loop may run. 0 = no deadline.
# STOCK_WINDOW_SECONDS=600
# Fraction of the context window at which history is summarized.
# COMPACT_THRESHOLD=0.9

# Shared character budget for files auto-injected into one turn when the user
# names them. Prefetched text sits in a user message, which compaction never
# rewrites. 0 = unlimited; turn injection off with PREFETCH_ENABLED=false.
# PREFETCH_MAX_CHARS=0
# PREFETCH_ENABLED=true

# ── Publication gate ──────────────────────────────────────────────────────
# The independent same-model review still runs and is still saved, but by
# default its findings do not block a publication. Set true to restore blocking
# (only findings the reviewer marks severity=blocking count).
# PUBLISH_REVIEW_ENFORCE=false
# Every published quote/number must appear in text the tools actually returned.
# This is the anti-fabrication root; set false to publish without that check.
# PUBLISH_QUOTE_CHECK=true

# Cloud boundary (can also be authorized per-workspace from the model settings)
WORKSPACE_CLOUD_ALLOWED=false
TOOL_TIER=all
# DEFAULT_MODEL=qwen:qwen3.5-flash
# MODEL_CATALOG=config/models.json
# DASHSCOPE_API_KEY=  # Prefer entering through the local Web settings.
# MODEL_CALL_LIMIT=30  # Persistent HTTP attempt budget, including failed attempts.
# CONTEXT_WINDOW=32768  # Token budget driving compaction (90%) and the UI figure;
#   set it near the selected model's real window (qwen3.8-flash measured >=256K).

# Stock bridge advanced override. Daily use is managed from the Web page
# (stock skill panel → 高级管理 → 连接配置); leave empty unless bypassing it.
# STOCK_BRIDGE_URL=http://127.0.0.1:8765
# STOCK_BRIDGE_TOKEN=
